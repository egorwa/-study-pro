<div class="mb-3">
    <label class="form-label">@Label</label>
    <div class="input-group">
        <InputText id="@InputId"
                   Value="@Value"
                   ValueChanged="@OnInternalValueChanged"
                   ValueExpression="@For"
                   type="password"
                   autocomplete="@Autocomplete"
                   class="form-control"
                   oninput="@OnInputJs" />
        <button type="button" class="btn btn-outline-secondary"
                onclick="accountHelpers.toggle('@InputId')">👁</button>
    </div>

    @if (ShowStrength)
    {
        <div class="progress mt-1" style="height: 6px;">
            <div id="@(InputId)-strength" class="progress-bar" style="width: 0;"></div>
        </div>
    }

    <ValidationMessage For="@For" class="text-danger small" />
    @if (!string.IsNullOrEmpty(CustomError))
    {
        <div class="text-danger small">@CustomError</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string InputId { get; set; } = "";
    [Parameter, EditorRequired] public Expression<Func<string>> For { get; set; } = default!;
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Autocomplete { get; set; } = "new-password";
    [Parameter] public bool ShowStrength { get; set; }
    [Parameter] public string? OnInputJs { get; set; }
    [Parameter] public string? CustomError { get; set; }

    private async Task OnInternalValueChanged(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}